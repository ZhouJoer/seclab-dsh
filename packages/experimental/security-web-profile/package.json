{
  "name": "@deepseek-ai/dsh-experimental-security-web-profile",
  "description": "Opt-in security workbench Web composition",
  "version": "0.2.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/security-web-profile"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-helper": "workspace:*",
    "@deepseek-ai/dsh-subagent-codex": "workspace:*",
    "@deepseek-ai/dsh-client-ui-helper": "workspace:*",
    "@deepseek-ai/dsh-experimental-client-ui-security-analysis": "workspace:*",
    "@deepseek-ai/dsh-experimental-security-profile": "workspace:*",
    "@deepseek-ai/dsh-experimental-research-workbench-bundle": "workspace:*",
    "@deepseek-ai/dsh-experimental-research-security": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis": "workspace:~",
    "js-yaml": "^4.2.0"
  },
  "icon": "./icon.svg"
}
