          >
            <path
              d="M4 6L7.29289 9.29289C7.68342 9.68342 8.31658 9.68342 8.70711 9.29289L12 6"
              stroke="currentColor"
            />
          </svg>
        </span>
      </summary>
      <div
        class="_fields_8aaa19"
      >
        <div
          class="_resourceForm_394143"
        >
          <fieldset>
            <legend>
              Analysis environments
            </legend>
            <label
