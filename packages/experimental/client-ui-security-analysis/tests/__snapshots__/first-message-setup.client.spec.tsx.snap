exports[`shows the actual environment and editable preferences in an associated blank restart draft 1`] = `"<details open=""><summary><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" stroke-width="1"><path d="M6.80132 2.14853C7.70663 1.80917 8.70422 1.80919 9.60952 2.14859L14.1296 3.84317V7.11961C14.1296 11.6089 10.7615 13.5975 8.20543 14.5779C5.64931 13.5975 2.28052 11.6089 2.28052 7.11961V3.84317L6.80132 2.14853Z" stroke="currentColor" stroke-linejoin="round"></path></svg><span class="_summary_8aaa19"><strong>This task</strong><span>Environment: mining</span></span><span class="_configure_8aaa19">Configure<svg width="16" height="16" class="_chevron_8aaa19" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" stroke-width="1"><path d="M4 6L7.29289 9.29289C7.68342 9.68342 8.31658 9.68342 8.70711 9.29289L12 6" stroke="currentColor"></path></svg></span></summary><div class="_fields_8aaa19"><details class="_card_394143" open=""><summary><span>Active session tool preferences</span><span> · Unrestricted, selected as needed</span></summary><fieldset class="_toolFields_394143"><label><input type="checkbox">Reverse engineering / 逆向分析</label><label><input type="checkbox" disabled="">Vulnerability mining / 漏洞挖掘</label><label><input type="checkbox">IoT / 物联网</label><label><input type="checkbox">Firmware and native binaries</label><label><input type="checkbox" disabled="">Web analysis</label><label><input type="checkbox" disabled="">Penetration testing / 渗透测试</label><label><input type="checkbox">Android</label><label><input type="checkbox">Packet capture</label><details><summary>Tool</summary><div class="_toolFields_394143"><label><input type="checkbox" disabled="">APK inventory<span>(Script workflow requires automatic selection)</span></label><label><input type="checkbox" disabled="">Reverse analysis scripts<span>(Script workflow requires automatic selection)</span></label><label>